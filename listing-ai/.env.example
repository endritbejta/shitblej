# Required for /suggest to work. Without it the service still boots, /health
# reports "degraded" and /suggest returns 503 — the Sell form stays usable.
ANTHROPIC_API_KEY=

# Optional. Defaults shown.
# PORT=8080
# HOST=0.0.0.0
# LOG_LEVEL=info

# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_EFFORT=medium        # low | medium | high — raises cost and latency
# MAX_OUTPUT_TOKENS=8000

# MAX_IMAGE_BYTES=5242880        # 5MB of decoded image bytes
# CACHE_MAX_ENTRIES=500
# CACHE_TTL_MS=3600000

# Comma-separated. Empty means same-origin only, which is correct when the
# marketplace backend proxies these calls.
# ALLOWED_ORIGINS=
