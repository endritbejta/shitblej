# Dependencies
node_modules/
**/node_modules/

# Local env files.
#
# The pattern that matters is `*.env`. Every rule below it is anchored to a
# name STARTING with `.env`, which is how backend/config/config.env - a real
# env file, with a live database URI, a JWT secret and an API key - was
# committed in the initial commit and sat in public history.
*.env
**/*.env
.env
**/.env
.env*.local
**/.env*.local
.env.production
**/.env.production
.env.development
**/.env.development
.env.staging
**/.env.staging

# ...but the templates are meant to be tracked. `*.env` does not match these
# (they end in `.example`), listed explicitly so the intent is unambiguous.
!*.env.example
!**/*.env.example

# OS files
.DS_Store
**/.DS_Store
Thumbs.db
**/Thumbs.db

# Build directories
**/dist/
**/dist-ssr/

# Debug logs
*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# Locally-stored uploads (UPLOAD_DRIVER=local). User content, and disposable.
.uploads/
**/.uploads/

# Playwright output. Traces and videos are kept only for failures, and are
# large; the report is regenerated by the next run.
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/
e2e/.cache/
