# Dependencies
node_modules/
**/node_modules/

# Local env files.
#
# The pattern that matters is `*.env`. Every rule below it is anchored to a
# name STARTING with `.env`, which is how backend/config/config.env - a real
# env file, with a live database URI, a JWT secret and an API key - was
# committed in the initial commit and sat in public history.
*.env
**/*.env
.env
**/.env
.env*.local
**/.env*.local
.env.production
**/.env.production
.env.development
**/.env.development
.env.staging
**/.env.staging

# ...but the templates are meant to be tracked. `*.env` does not match these
# (they end in `.example`), listed explicitly so the intent is unambiguous.
!*.env.example
!**/*.env.example

# OS files
.DS_Store
**/.DS_Store
Thumbs.db
**/Thumbs.db

# Expo and Web build directories
frontend mobile/.expo/
**/dist/
**/dist-ssr/
frontend mobile/web-build/
frontend mobile/expo-env.d.ts

# Native builds & keystores
frontend mobile/*.orig.*
frontend mobile/*.jks
frontend mobile/*.p8
frontend mobile/*.p12
frontend mobile/*.key
frontend mobile/*.mobileprovision

# Metro health checks
frontend mobile/.metro-health-check*

# Debug logs
*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# TypeScript build info
frontend mobile/*.tsbuildinfo
