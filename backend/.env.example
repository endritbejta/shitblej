# --- Application ------------------------------------------------
# development | production | test
NODE_ENV=development
PORT=3000

# URL of the frontend allowed by CORS (and Socket.io)
CLIENT_URL=http://localhost:5173

# Number of reverse proxies in front of the app, used to resolve the real
# client IP for rate limiting. 0 when running directly (local dev); set to 1
# behind Render, Heroku or a single Nginx ingress. Too high lets a client
# spoof its IP past the rate limiter; too low makes every request look like
# it came from the proxy, so one user exhausts everyone's quota.
TRUST_PROXY_HOPS=0

# Log verbosity: trace | debug | info | warn | error | fatal | silent.
# Defaults to info (silent under NODE_ENV=test, so the suite's own output stays
# readable). Successful requests log at debug, so set this to debug when you
# want a full access log; at info only warnings and errors are recorded.
# LOG_LEVEL=info

# --- Database ---------------------------------------------------
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# --- Auth (JWT) -------------------------------------------------
# Use a long, random secret in production (e.g. `openssl rand -base64 48`)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRE=30d

# --- Background jobs -------------------------------------------
# How often to sweep for overdue offers and release reservations held by
# agreements that were never checked out. Default 5 minutes.
OFFER_SWEEP_INTERVAL_MS=300000

# How long notifications are kept, in days, enforced by a MongoDB TTL index.
# WARNING: the first time this index builds against an existing database it
# deletes every notification older than the window. Set to 0 to keep forever.
NOTIFICATION_TTL_DAYS=90

# --- Image uploads ----------------------------------------------
# cloudinary | local
#
# "local" writes uploads to UPLOAD_DIR and serves them back at /uploads, so
# the app runs from a fresh clone - and a product can actually be listed -
# without a Cloudinary account. Handy for local development and for the
# end-to-end tests.
#
# It is refused in production: local disk on a container platform is ephemeral
# and per instance, so images would vanish on the next deploy and 404 on every
# instance except the one that received the upload.
UPLOAD_DRIVER=cloudinary
# Relative to the backend directory, or absolute. Only used by UPLOAD_DRIVER=local.
UPLOAD_DIR=.uploads

# Origin the stored image URLs are absolute against, for UPLOAD_DRIVER=local.
# Defaults to http://127.0.0.1:<PORT>. It must be absolute: a root-relative
# "/uploads/x.png" resolves against whatever origin served the page, which is
# the static host and not the API - so every image 404s as soon as the
# frontend is deployed separately, which it is.
# UPLOAD_PUBLIC_BASE_URL=http://127.0.0.1:3000

# Required when UPLOAD_DRIVER=cloudinary (the default); ignored otherwise.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Rate limit overrides ---------------------------------------
# Unset means "use the default for this NODE_ENV" - 10 auth requests and 300
# API requests per 15 minutes outside tests. Set these to respond to a burst,
# or to loosen the login limit for an end-to-end run, without a code change.
# Counters are namespaced per limiter, so API traffic never spends the auth
# allowance.
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_API_MAX=300
