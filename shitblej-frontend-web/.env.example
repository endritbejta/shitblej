# --- API ---------------------------------------------------------
# Origin of the backend, WITHOUT a trailing slash and without /api/v1
# (src/lib/config.js appends the version prefix).
#
# Required for any production build: the build fails fast at startup rather
# than issuing requests to relative paths that resolve against the static
# host. Not used in `npm run dev` - dev goes through the Vite proxy below.
VITE_API_URL=https://shitblej.onrender.com

# Origin for the realtime socket. Defaults to VITE_API_URL when unset, which
# is right whenever REST and Socket.IO are served by the same process.
# VITE_SOCKET_URL=https://shitblej.onrender.com

# --- Dev server --------------------------------------------------
# Where `npm run dev` proxies /api and /socket.io (see vite.config.js).
# Defaults to the hosted backend so the frontend runs standalone; point it at
# a local backend for full-stack work.
# Note: no VITE_ prefix - this is read by vite.config.js at startup, not
# inlined into the client bundle.
# API_PROXY_TARGET=http://localhost:3000
